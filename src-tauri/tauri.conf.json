{
  "$schema": "https://schema.tauri.app/config/2",
"productName": "Kodra",
  "version": "0.1.0",
  "identifier": "com.utkui.kodra",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kodra",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Utku",
    "homepage": "https://github.com/Utku4836/Kodra",
    "category": "DeveloperTool",
    "shortDescription": "A keyboard-first desktop AI workspace.",
    "longDescription": "Kodra connects multiple AI providers to native coding tools, persistent local sessions, diagnostics, and a permission-aware terminal interface.",
    "copyright": "Copyright © 2026 Utku. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
